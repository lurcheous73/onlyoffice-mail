FROM redis:8.4.6-alpine@sha256:0b0ae6770e7d416846dca4227382538fe4cc7e002e4feb04e4ade5fa851d920c
RUN apk upgrade --no-cache
EXPOSE 6379
CMD ["redis-server", "--bind", "0.0.0.0", "--protected-mode", "no", "--appendonly", "yes", "--appenddirname", "appendonlydir", "--appendfilename", "appendonly.aof", "--dir", "/data"]
